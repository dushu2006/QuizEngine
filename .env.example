# Copy to .env in the repository root. Never commit .env or paste keys into YAML.
# offline requires no credential and makes no external model calls.
MODEL_PROVIDER=offline

# Gemini (used only when MODEL_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PRIMARY_MODEL=gemini-2.0-flash
GEMINI_FAST_MODEL=
GEMINI_VISION_MODEL=
GEMINI_VERIFIER_MODEL=

# NVIDIA NIM (used only when MODEL_PROVIDER=nvidia; no fallback to Gemini)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_PRIMARY_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_FAST_MODEL=
NVIDIA_NIM_VISION_MODEL=
NVIDIA_NIM_VERIFIER_MODEL=

# Provider request and orchestration tuning
MODEL_REQUEST_TIMEOUT_SECONDS=8
MODEL_MAX_RETRIES=1
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=256
MODEL_PRIMARY_CONFIDENCE_THRESHOLD=0.75
MODEL_VERIFICATION_CONFIDENCE_THRESHOLD=0.85
ENABLE_PARALLEL_MODEL_CALLS=true
ENABLE_FAST_PATH=true
ENABLE_TIER2_PERCEPTION=true
ENABLE_RESULT_CACHE=true
ENABLE_SCREEN_CACHE=true
MAX_PARALLEL_MODELS=2

# Manual Windows hotkeys (modifiers + one ASCII letter/digit)
AGENT_START_HOTKEY=win+alt+q
AGENT_STOP_HOTKEY=win+alt+x

# Logging/debug. Screenshot artifacts are off unless explicitly retained.
TELEMETRY_LEVEL=normal
DEBUG_MODE=false
RETAIN_DEBUG_ARTIFACTS=false
